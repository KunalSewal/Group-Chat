# Copy this file to server/.env and fill in your own values.
# server/.env is ignored by git, so the real connection string is never
# committed. Never put a password in this example file.

# Connection string for the MongoDB Atlas cluster.
# Get it from Atlas: Cluster -> Connect -> Drivers -> Node.js.
# Replace <password> with the database user's password.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# Database name inside the cluster. Optional, defaults to csd_group_chat.
# MONGODB_DB_NAME=csd_group_chat

# Key used to encrypt messages before they are stored: 32 bytes, base64 encoded.
# Generate your own with "npm run generate-key" and paste it here. There is no
# real key in this file on purpose, and the server refuses to start without one.
# Changing the key makes every message already in the database unreadable.
CHAT_ENCRYPTION_KEY=

# Port the chat server listens on. Optional, defaults to 4000.
# The client dev server uses 3000, so avoid that one.
# PORT=4000

# The other two backends, so this one replicates what it accepts and can repair
# gaps left while a peer was unreachable. Comma separated, no trailing slash.
# PEERS=http://10.1.75.53:3267,http://10.1.75.53:3268

# --- limits, only worth setting when the container is small ---

# The cap that bounds this process's memory. FEED_MAX_MESSAGES bounds how much
# work rebuilding the feed does; it does not bound how much that allocates,
# because the length of a message is the client's choice. Default 16MB.
# FEED_MAX_BYTES=16777216
# FEED_MAX_MESSAGES=30000

# Fraction of the container's memory budget at which the backend starts giving
# buffers back, and at which it starts shortening the conversation to do it.
# FEED_SHED_AT=0.80
# FEED_SHED_HARD_AT=0.90

# How hard to compress the cached feed, 1-9. Compression runs once per rebuild
# and is served to every request in that window, so a better ratio costs little
# per request — but it only helps if the bytes are what the reader waits on.
# Level 4 is about 10% smaller than level 1 for 15ms more CPU per rebuild:
# worth it across a slow link, wasted across a fast one.
# FEED_GZIP_LEVEL=1
